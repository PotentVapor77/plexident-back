# Copia este archivo como .env y ajusta los valores.
#   .env.example .env

# ============================================================================
# DJANGO CORE
# ============================================================================

# Modo depuración. True para desarrollo (muestra trazas de error detalladas),
# False SIEMPRE en producción.
DEBUG=False

# Clave secreta de Django. Genera una aleatoria y segura, NUNCA la compartas.
#  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())" (Clave de ejemplo)
SECRET_KEY=django-insecure-((87lg=brv2jgp5x_kv#gz9vz!gg6c7^sr)@vwk!r9jlgm$$eo^

# Hosts/nombres de dominio permitidos, separados por coma.
# Incluye "backend" para que funcione dentro de Docker Compose.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ============================================================================
# DATABASE
# ============================================================================

# Nombre de la base de datos PostgreSQL.
DB_NAME=famysalud_db

# Usuario de PostgreSQL.
DB_USER=postgres

# Contraseña del usuario de PostgreSQL.
DB_PASSWORD=12345

# Host de la base de datos. "localhost" localmente, "db" dentro de Docker.
DB_HOST=localhost

# Puerto de PostgreSQL. 5432 default, 5433 si hay otro Postgres local ocupando el 5432.
DB_PORT=5433

# ============================================================================
# CORS
# ============================================================================

# Orígenes (frontends) autorizados a consumir la API, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================================
# REDIS (opcional)
# ============================================================================

# URL de conexión a Redis (cache/colas). Opcional; si no hay Redis se degrada.
REDIS_URL=redis://127.0.0.1:6379/1

# ============================================================================
# EMAIL
# ============================================================================

# Servidor SMTP saliente.
EMAIL_HOST=smtp.gmail.com

# Puerto SMTP. 587 con STARTTLS (recomendado).
EMAIL_PORT=587

# Usar TLS para la conexión SMTP (True/False).
EMAIL_USE_TLS=True

# Cuenta de correo que envía los emails (para Gmail usa tu correo completo).
EMAIL_HOST_USER=tucorreo@gmail.com

# Contraseña de aplicación del correo (NO la contraseña normal de la cuenta).
EMAIL_HOST_PASSWORD=tu-contrasena-de-app

# Remitente que se muestra en los correos enviados.
DEFAULT_FROM_EMAIL=FamySALUD <tucorreo@gmail.com>

# Correo del administrador del sistema (recibe notificaciones).
ADMIN_EMAIL=tucorreo@gmail.com

# URL pública del frontend (usada en enlaces de los emails: reset de contraseña, etc.).
FRONTEND_URL=http://localhost:5173

# ============================================================================
# ADMIN INICIAL (bootstrap - se crea SOLO en el primer arranque)
# CAMBIA la contraseña en producción.
# ============================================================================

# Nombre de usuario del administrador inicial.
DEFAULT_ADMIN_USERNAME=admin

# Contraseña del administrador inicial. Cámbiala en producción.
DEFAULT_ADMIN_PASSWORD=admin123

# Correo del administrador inicial.
DEFAULT_ADMIN_EMAIL=tucorreo@gmail.com

# Nombre(s) del administrador inicial.
DEFAULT_ADMIN_NOMBRES=Administrador

# Apellido(s) del administrador inicial.
DEFAULT_ADMIN_APELLIDOS=Sistema

# Teléfono del administrador inicial.
DEFAULT_ADMIN_TELEFONO=0999999999

# ============================================================================
# STORAGE (AWS S3 / MinIO)
# Backend de almacenamiento: "s3" para AWS S3 en producción
# ============================================================================
STORAGE_BACKEND=minio
AWS_STORAGE_BUCKET_NAME=plexident-clinical-files
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_REGION_NAME=us-east-1
MINIO_ENDPOINT_URL=http://localhost:9000

